# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
SECRET_KEY=generate-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=720
ENVIRONMENT=development

# First payroll administrator (change the password after first login)
PAYROLL_ADMIN_USERNAME=admin
PAYROLL_ADMIN_PASSWORD=choose-a-strong-password

# POS backend, used for single sign-on from the POS
POS_API_URL=http://127.0.0.1:8000

WORK_START_TIME=08:00
WORKING_DAYS_PER_MONTH=26
