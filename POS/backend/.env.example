# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
SECRET_KEY=generate-a-long-random-value   # python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=development

# "cloud" = use DATABASE_URL directly; "local" = offline-first SQLite + background sync
# (the desktop launcher sets local mode itself).
POS_MODE=cloud

# Product images (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Website admin API (must match ADMIN_API_KEY in Website/backend/.env)
WEBSITE_API_URL=http://127.0.0.1:8001
WEBSITE_ADMIN_KEY=

# Optional
# TAX_RATE=0.0
# TAX_INCLUSIVE=true
# COMPANY_TIN=
